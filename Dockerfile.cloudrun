# syntax=docker/dockerfile:1.7
#
# OpenFathom delta — allowed by ADR-002.
#
# This does NOT reinvent the upstream build (s6-overlay, Node, Playwright, uv --
# see the real `Dockerfile` in this repo's root). Reinventing it in a slim
# python:3.11 image, as an earlier draft of openfathom-meta's
# guides/cloud-run-deployment.md assumed before this repo was ever cloned
# locally, would silently drop the real build's system deps and produce an
# image where `hermes` does not run. Instead: build the upstream Dockerfile
# first (tag it BASE_IMAGE), then layer packaging on top -- same posture
# ADR-002 already committed to ("empacotamento sem divergir no core").
#
#   docker build -t of-agent:base .
#   docker build -f Dockerfile.cloudrun -t of-agent:cloudrun .
#
# ENTRYPOINT is intentionally NOT redeclared here -- whatever BASE_IMAGE
# declares is inherited verbatim. This comment used to assert that value was
# `["/init", "/opt/hermes/docker/main-wrapper.sh"]`; the upstream sync of
# 2026-08-03 (#48) changed it to `["/opt/hermes/docker/entrypoint-dispatch.sh"]`
# (upstream #38349) and the comment outlived the fact. Asserting the inherited
# value here is what went stale, so it is not asserted again: read it from the
# base image's own `Dockerfile`.
#
# What DOES matter to this file, and is stable across that change: the boot
# must go through `/init`. The dispatcher preserves it when the container owns
# PID 1 -- the Cloud Run case -- by exec'ing `/init main-wrapper.sh "$@"`; its
# non-PID-1 fallback (Fly Machines, `docker run --init`) skips s6 supervision
# and does not apply to us. docker-compose.yml's own warning is the reason:
# bypassing /init skips the stage2-hook.sh UID/GID remap and venv seed, which
# cloudrun-entrypoint.sh still needs even for a single Cloud Run Job invocation.
ARG BASE_IMAGE=of-agent:base
FROM ${BASE_IMAGE}

COPY scripts/cloudrun-entrypoint.sh /opt/hermes/scripts/cloudrun-entrypoint.sh
RUN chmod +x /opt/hermes/scripts/cloudrun-entrypoint.sh

# hermes-plugins/document-reader (openfathom-bridges) reads PDF/DOCX/XLSX
# attachments -- openfathom-meta ADR-062/ADR-063. pypdf and openpyxl are the
# deliberate stdlib-only exception those ADRs register (parsing a document
# format is not something the standard library does); both confirmed
# pure-Python via PyPI's JSON API on 2026-08-21 (py3-none-any wheel, no
# compiled dependency) -- python-docx was rejected for requiring lxml, a
# compiled extension, so DOCX extracts via stdlib zipfile+ElementTree
# instead and needs nothing installed here. Pinned, not a caret range, same
# discipline as openfathom-bridges' provider pins.
#
# The pin must ALSO be older than the resolver's window: pyproject.toml sets
# `exclude-newer = "14 days"`, so `uv` refuses any release published inside
# it and reports the pin as if the version did not exist at all --
# "Because there is no version of pypdf==X, we can conclude that your
# requirements are unsatisfiable". That is what broke this build on
# 2026-08-21: pypdf 6.16.1 was published 2026-08-14, seven days before, so
# the latest release was unbuildable BY CONSTRUCTION. 6.15.0 (2026-08-06)
# is the newest one outside the window, and a pin only ages further out of
# it. When bumping this, check the upload date, not just the version.
RUN uv pip install --python /opt/hermes/.venv/bin/python --no-cache-dir \
    pypdf==6.15.0 openpyxl==3.1.5

# hermes-plugins/youtube-transcript (openfathom-bridges) reads a video's
# caption track -- openfathom-meta ENG-231. The bundled upstream skill
# `youtube-content` is competent but its workflow shells out to
# `uv run python .../fetch_transcript.py`, and terminal/code_execution are
# disabled (ENG-51, ADR-043); measured 2026-09-07, the model fell back to
# web_extract, which returns the YouTube page and no captions. Same
# third-party exception ADR-062 registers for pypdf/openpyxl.
#
# Verified on PyPI 2026-09-08, and the date is the check that matters, not
# the version number: 1.2.4 was published 2026-01-29, far outside the
# `exclude-newer = "14 days"` window that made a pypdf pin unbuildable BY
# CONSTRUCTION above. It is pure-Python (py3-none-any), and its only
# non-stdlib dependencies -- requests and defusedxml 0.7.1 -- are already
# pinned in pyproject.toml at exactly those versions, so this resolves
# without moving anything else.
RUN uv pip install --python /opt/hermes/.venv/bin/python --no-cache-dir \
    youtube-transcript-api==1.2.4

# Cloud Run Service injects $PORT at runtime (see cloudrun-entrypoint.sh);
# 8080 is only the documented default for local `docker run -p`.
EXPOSE 8080

# main-wrapper.sh's routing (docker/main-wrapper.sh): first arg is an
# executable -> exec it directly. Passing our script as CMD (rather than
# `hermes <args>`) is what lets it choose between `hermes gateway run` and
# `hermes -z` at runtime via HERMES_MODE, instead of being fixed at build time.
CMD ["/opt/hermes/scripts/cloudrun-entrypoint.sh"]
